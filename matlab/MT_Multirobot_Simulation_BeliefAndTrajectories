% === Callback function for spacebar press ===
function keypress_callback(~, event)
    if strcmp(event.Key, 'space')
        global is_paused;
        is_paused = ~is_paused;
        if is_paused
            disp('⏸️  Animation paused. Press [space] again to resume.');
        else
            disp('▶️  Animation resumed.');
        end
    end
end
