% === Base experiment path (we assume only one subfolder) ===
base_path = '/home/mzarias/Workspace/MT_Marc/plume_model_learning/Results/cluster_analysis';
d = dir(base_path);
subfolder = d([d.isdir] & ~startsWith({d.name}, '.'));  % filter out hidden/system folders

if isempty(subfolder)
    error('No subfolder found inside cluster_analysis');
end

exp_folder = fullfile(base_path, subfolder(1).name);  % full path to experiment folder

% === Visualization speed settings ===
show_cell_indices = false;
repr_vel = 3;           % How many steps to skip per frame (for robot position update)
video_repr_vel = repr_vel*10;    % Frame rate of the output video

% === Robot IDs and corresponding colors ===
robot_ids = [101, 102, 103];
robot_colors = {[1 1 1], [1 1 1], [1 1 1]}; % red, blue, green

% === Load position history for each robot ===
positions = cell(1,3);
for r = 1:3
    pos_path = fullfile(exp_folder, num2str(robot_ids(r)), 'whole_position_history.csv');
    pos_data = readmatrix(pos_path);
    positions{r} = round(pos_data(:, 1:2), 1);  % round X, Y positions to 1 decimal
end


% === Load intensity map (direct, no need to skip columns) ===
intensity_path = fullfile(exp_folder, '101', 'posterior_pdf_3D.csv');
intensity_data = readmatrix(intensity_path);
intensity_maps = intensity_data;  % todos los valores son intensidades


% === Load goal positions for each robot ===
goal_positions = cell(1,3);
reached_goals = zeros(1,3); 

goal_update_count = 0;
for r = 1:3
    goal_path = fullfile(exp_folder, num2str(robot_ids(r)), 'goal_position.csv');
    goal_data = readmatrix(goal_path);
    goal_positions{r} = round(goal_data(:, 2:3), 1);  % X, Y columns
end

% === Load ground truth gas source position ===
source_path = fullfile(exp_folder, '101','source_pos.csv');
source_text = fileread(source_path);
tokens = sscanf(source_text, 'source_position %f %f %f');
source_x = tokens(1);
source_y = tokens(2);

% === Load trajectory path ===
traj_path = fullfile(exp_folder, '101', 'trajectory.csv');
traj_data = readmatrix(traj_path);
traj_cycles = traj_data(:, 1);
traj_x = traj_data(:, 2);
traj_y = traj_data(:, 3);

% === Load trajectory paths for all robots ===
traj_data_all = cell(1, 3);
traj_cycles_all = cell(1, 3);
traj_x_all = cell(1, 3);
traj_y_all = cell(1, 3);

for r = 1:3
    traj_path_r = fullfile(exp_folder, num2str(robot_ids(r)), 'trajectory.csv');
    traj_data_r = readmatrix(traj_path_r);
    traj_data_all{r} = traj_data_r;
    traj_cycles_all{r} = traj_data_r(:, 1);
    traj_x_all{r} = traj_data_r(:, 2);
    traj_y_all{r} = traj_data_r(:, 3);
end

% === Setup figure ===
figure('Position', [100, 100, 1200, 400]);
axis equal;
hold on;
wall_thickness = 0.1;
axis([-wall_thickness 16 + wall_thickness -wall_thickness 4 + wall_thickness]);
xlabel('X (m)');
ylabel('Y (m)');
title('FSM cycle: 1');

% Add key press callback for pausing
set(gcf, 'KeyPressFcn', @keypress_callback);
global is_paused;
is_paused = false;

% === Create cells using PATCH (without white lines) ===
cols = 20; rows = 20;
x_edges = linspace(3, 12.5, cols + 1);
y_edges = linspace(0.16, 3.8, rows + 1);
cell_widths = diff(x_edges);
cell_heights = diff(y_edges);

cell_patches = gobjects(rows, cols);  % para guardar cada celda

for i = 1:cols
    for j = 1:rows
        x = x_edges(i);
        y = y_edges(j);
        w = cell_widths(i);
        h = cell_heights(j);

        % Coordenadas del cuadrado (en sentido horario)
        xv = [x, x + w, x + w, x];
        yv = [y, y, y + h, y + h];

        % Crear patch sin borde
        cell_patches(j, i) = patch(xv, yv, [1 1 1], 'EdgeColor', 'none');

        % Mostrar índices si se activa la opción
        if show_cell_indices
            % Calcular el centro de la celda
            cx = x + w / 2;
            cy = y + h / 2;

            % Calcular el índice lineal como en belief_map: (row - 1) * cols + col
            index = (j - 1) * cols + i;

            % Mostrar el índice
            text(cx, cy, num2str(index), 'FontSize', 8, 'HorizontalAlignment', 'center', 'Color', [0.3 0.3 0.3]);
        end

    end
end




% === Define soft colors for class coloring (border cell) ===
green_edge = [0.88, 0.95, 0.88];  % verde pastel más suave
blue_edge  = [0.88, 0.88, 0.95];  % azul pastel más suave
red_edge   = [0.95, 0.88, 0.88];  % rojo pastel más suave


% === Define soft colors for class coloring (inside cell) ===
white = [1, 1, 1];
green_soft = [0.45 0.85 0.45];
blue_soft  = [0.45 0.45 0.85];
red_soft   = [0.85 0.45 0.45];
yellow = [1, 0.75, 0.1];  % used for estimated source
dark_gray  = [0.3 0.3 0.3];  % used for walls and obstacles

% === Draw walls ===
rectangle('Position', [-wall_thickness, -wall_thickness, 16 + wall_thickness, wall_thickness], 'FaceColor', dark_gray);
rectangle('Position', [0, 4, 16 + wall_thickness, wall_thickness], 'FaceColor', dark_gray);
rectangle('Position', [-wall_thickness, 0, wall_thickness, 4 + wall_thickness], 'FaceColor', dark_gray);
rectangle('Position', [16, 0 - wall_thickness, wall_thickness, 4 + wall_thickness], 'FaceColor', dark_gray);

% === Draw obstacles ===
rectangle('Position', [8.0, 0.0, 0.5, 2.0], 'FaceColor', dark_gray);
rectangle('Position', [4.5, 2.0, 0.5, 2.0], 'FaceColor', dark_gray);

% === Plot ground truth gas source (black star) ===
plot(source_x, source_y, 'p', 'MarkerSize', 16, ...
    'MarkerEdgeColor', 'k', 'MarkerFaceColor', 'r');

traj_line = gobjects(1, 3);
traj_dots = gobjects(1, 3);

colors = {white, white, white};

for r = 1:3
    traj_line(r) = plot(NaN, NaN, '-', 'Color', colors{r}, 'LineWidth', 2);
    traj_dots(r) = plot(NaN, NaN, '.', 'Color', colors{r}, 'MarkerSize', 10);
end


% === Initialize robot and goal markers ===
robot_markers = gobjects(1,3);
goal_markers = gobjects(1,3);
for r = 1:3
    % Robot: círculo blanco con borde negro
    robot_markers(r) = plot(NaN, NaN, 'o', 'MarkerSize', 8, ...
        'MarkerFaceColor', 'w', 'MarkerEdgeColor', 'k');

    % Goal: cuadrado blanco con borde negro
    goal_markers(r) = plot(NaN, NaN, 's', 'MarkerSize', 8, ...
        'MarkerFaceColor', 'w', 'MarkerEdgeColor', 'k');
end


% === Create video writer object ===
output_video_path = '/home/mzarias/Workspace/MT_Marc/plume_model_learning/Results/videos/animation.avi';
v = VideoWriter(output_video_path, 'Motion JPEG AVI');
v.FrameRate = video_repr_vel;
open(v);

% === Prepare iteration variables ===
max_steps = max(cellfun(@(p) size(p,1), positions));
goal_idx = ones(1, 3);
waiting = false(1,3);
last_pos = zeros(3, 2);
t_idx = ones(1, 3);
done = false(1, 3);

% === Animation loop ===
for frame_t = 1:10000
    % --- Actualizar belief map si corresponde ---
    if all(reached_goals)
        for r = 1:3
            goal_idx(r) = goal_idx(r) + 1;
            waiting(r) = false;
        end
        reached_goals = zeros(1,3);
        goal_update_count = goal_update_count + 1;

        if goal_update_count <= size(intensity_maps, 1)
            idx = goal_update_count;
            intensity_map = intensity_maps(goal_update_count, :);

            % Normalizar intensidad
            min_int = min(intensity_map);
            max_int = max(intensity_map);
            if max_int > min_int
                intensity_map = (intensity_map - min_int) / (max_int - min_int);
            else
                intensity_map = zeros(size(intensity_map));
            end

            % === Actualizar color de celdas y bordes ===
            % === Actualizar color de celdas basado en intensidad ===
            for col = 1:cols
                for row = 1:rows
                    map_idx = (row - 1) * cols + col;
                    intensity = max(0, min(1, intensity_map(map_idx)));

                    % Escalar a color usando colormap (e.g., parula)
                    cmap = parula(256);  % o 'hot', 'jet', etc.
                    color_idx = max(1, round(intensity * 255)) + 1;  % de 1 a 256
                    base_color = cmap(color_idx, :);

                    % Aplicar color al patch
                    set(cell_patches(row, col), 'FaceColor', base_color);
                end
            end

            colormap(parula); % Puedes cambiar a 'parula', 'hot', 'jet', etc.
            caxis([0 1]);     % Rango de intensidades esperadas (probabilidades)
            colorbar;         % Añade la escala a la derecha




            title(sprintf('FSM cycle: %d', idx), 'FontSize', 14, 'FontWeight', 'bold');
            
            % === Filtrar y graficar puntos de trayectoria para el FSM actual ===
            curr_cycle = idx;

            for r = 1:3
                traj_cycles = traj_cycles_all{r};
                traj_x = traj_x_all{r};
                traj_y = traj_y_all{r};

                mask = abs(traj_cycles - goal_update_count) < 1e-3;
                curr_x = traj_x(mask);
                curr_y = traj_y(mask);

                set(traj_line(r), 'XData', curr_x, 'YData', curr_y);
                set(traj_dots(r), 'XData', curr_x, 'YData', curr_y);
            end
        end
    end

    % --- Move robots and goals after coloring cells ---
    for r = 1:3
        if ~done(r) && t_idx(r) <= size(positions{r}, 1)
            curr_pos = positions{r}(t_idx(r), :);

            if goal_idx(r) <= size(goal_positions{r}, 1)
                gx = goal_positions{r}(goal_idx(r), 1);
                gy = goal_positions{r}(goal_idx(r), 2);
                dist = norm(curr_pos - [gx, gy]);

                reached_goals(r) = dist < 0.15;
                set(goal_markers(r), 'XData', gx, 'YData', gy);

            end

            if ~reached_goals(r)
                set(robot_markers(r), 'XData', curr_pos(1), 'YData', curr_pos(2));
                last_pos(r, :) = curr_pos;
                t_idx(r) = t_idx(r) + repr_vel;
                if t_idx(r) > size(positions{r}, 1)
                    t_idx(r) = size(positions{r}, 1);
                    done(r) = true;
                end
            else
                set(robot_markers(r), 'XData', last_pos(r, 1), 'YData', last_pos(r, 2));
            end

        else
            done(r) = true;
        end
    end

    % --- Pausar si se requiere ---
    drawnow;
    while is_paused
        pause(0.1);
    end

    pause(0.00001);
    frame = getframe(gcf);
    writeVideo(v, frame);


    if all(done)
 
        % === Plot estimated source position ===
        expected_path = fullfile(exp_folder, '101', 'expected_a_posteriori.csv');
        expected_data = readmatrix(expected_path);
        estimated_x = expected_data(end, 2);
        estimated_y = expected_data(end, 3);
        plot(estimated_x, estimated_y, 'p', 'MarkerSize', 16, ...
            'MarkerEdgeColor', 'k', 'MarkerFaceColor', yellow);

        %=== Success rate === 
        x_error = abs(estimated_x - source_x);
        y_error = abs(estimated_y - source_y);

        if x_error < 1 && y_error < 0.5
            msg = 'SOURCE FOUND ✅';
            color = [0.1 0.6 0.1];  
        else
            msg = 'SOURCE NOT FOUND ❌';
            color = [0.8 0.1 0.1];  
        end

        % Display msg in figure
        text(9.5, -1, msg, 'FontSize', 14, 'FontWeight', 'bold', ...
            'Color', color, 'Units', 'data');
        
        for i=1:20
            frame = getframe(gcf);
            writeVideo(v, frame);
        end
        close(v);
        break;
    end
end




