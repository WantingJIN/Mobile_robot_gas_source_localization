FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.00275;

boundaryField
{
    //- Set patchGroups for constraint patches
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           uniform 0.00275;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.00275;
        value           uniform 0.00275;
    }
    walls
    {
        type            kqRWallFunction;
        value           uniform 0.00275;
    }
    obstacles
    {
        type            kqRWallFunction;
        value           uniform 0.00275;
    }
}


