FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 3.375;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 3.375;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 3.375;
        value           uniform 3.375;
    }
    walls
    {
        type            omegaWallFunction;
        value           uniform 3.375;
    }
}


