FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         steadyState;
}

gradSchemes
{
    default cellLimited leastSquares 1;
    grad(p) Gauss linear 0.333;
    grad(U) cellLimited leastSquares 1;
}

divSchemes
{
    default         Gauss upwind;
    div(phi,U)      Gauss upwind;

    div(phi,k)      Gauss upwind;

    div((nuEff*dev2(T(grad(U))))) Gauss linear;
    div(phi,omega)  Gauss upwind;
}

laplacianSchemes
{
    default         Gauss linear corrected 0.5;
    laplacian(nuEff,U) Gauss linear limited corrected 0.5;
    laplacian((1|A(U)),p) Gauss linear limited corrected 0.5;
    laplacian(nu,U) Gauss linear limited corrected 0.5;
}

interpolationSchemes
{
    default         linear;
    interpolate(HbyA) linear;
}

snGradSchemes
{
    default         limited 0.5;
}

fluxRequired {
    default no;
    p ;
}

wallDist
{
    method meshWave;
}


