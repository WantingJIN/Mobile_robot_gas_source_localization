# Static target, used when compiling with "make static"
STATICTARGET	:= $(strip $(TARGET))-static

################## Toolchain Selection ##################
# Activate one of the toolchains below by commenting out the corresponding lines.
# Note that if you change the toolchain, you need to recompile all modules before recompiling all programs. The k3-make-all script will help you doing this.

# Toolchain (compiler, linker, ...) if you are using kernel 2.4 (korebot-tools-0.1.2)
#CC			:= arm-linux-gcc

# Toolchain (compiler, linker, ...) if you are using kernel 2.6 (korebot-oetools-1.0)
#CC			:= arm-angstrom-linux-gnueabi-g++ -std=gnu++0x

# Toolchain for 2019 Kheperas
# CC needs additional arguments which are set by opt/poky/1.8/environment-setup-...
# following works by ourcing the file in bash and outputting the modified environment, after formatting it, to a file called makeenv which is then sourced by the makefile.
IGNORE := $(shell bash -c "source /opt/poky/1.8/environment-setup-cortexa8hf-vfp-neon-poky-linux-gnueabi; env | sed 's/=/:=/' | sed 's/^/export /' > makeenv")
include makeenv
#CFLAGS_ADD += -std=c++11
 
#########################################################

# Preparing files and flags
SRCS		:= $(wildcard *.cpp)
OBJS		:= $(SRCS:.cpp=.o)
MODS		:= $(MODS_ADD)
MODS		:= $(MODS) $(foreach MOD,$(MY_MODULES),$(MOD)/*.a)
MODS		:= $(MODS) $(foreach MOD,$(MODULES),$(K4_ROOT)/Modules/$(MOD)/$(MOD).a)
INCS		:= $(INCS_ADD)
INCS		:= $(INCS) $(foreach MOD,$(MY_MODULES),-I $(MOD))
INCS		:= $(INCS) $(foreach MOD,$(MODULES),-I $(K4_ROOT)/Modules/$(MOD))
LIBS		:= -lm $(LIBS_ADD)
CFLAGS 		:= $(CFLAGS_ADD)

$(TARGET): $(OBJS) $(MODS)
	@echo "=== Building $@"
	$(CXX) -o $@ $(OBJS) $(INCS) $(CFLAGS) $(LIBS) $(MODS)

$(STATICTARGET): $(OBJS)
	@echo "=== Building $@ (statically)"
	$(CXX) -o $@ $(OBJS) -static $(INCS) $(CFLAGS) $(LIBS) $(MODS)

.PHONY: all
all: $(TARGET)

.PHONY: static
static: $(STATICTARGET)

.PHONY: clean
clean:
	@echo "=== Cleaning"
	rm -f *.o .depend $(TARGET) $(STATICTARGET) *~

.PHONY: depend
depend:
	@echo "=== Building dependencies"
	rm -f .depend
	touch .depend
	makedepend $(SYS_INCLUDES) $(INCS) -Y -f .depend $(SRCS)

%.o: %.cpp
	@echo "=== Compiling $@"
	$(CXX) -Wall $(INCS) -c $(CFLAGS) $< -o $@

ifeq (.depend,$(wildcard .depend))
include .depend 
endif
